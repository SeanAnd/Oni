#!/usr/bin/env python3
"""Execute the fixed, bounded tool policy; stdout is always a JSON envelope."""
import argparse
import json
from workstation_jobs import execute, parse_request, public_state
from workstation_common import json_error


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--request-json', required=True)
    args = parser.parse_args()
    request, issue = parse_request(args.request_json)
    if request is None:
        print(json.dumps(json_error('INVALID_PAYLOAD', issue)))
        return 2
    print(json.dumps(public_state(execute(request))))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
