#!/usr/bin/env python3
"""Persist an app-generated credential via protected stdin; never rotate implicitly."""
import json
import sys
from workstation_database import ManagedDatabase, DatabaseError, parse_request
from workstation_common import atomic_write

try:
    request = parse_request(sys.stdin.read(8193))
    if request['operation'] != 'initialize':
        raise DatabaseError('INVALID_PAYLOAD', 'Only initial credential pairing is supported.')
    db = ManagedDatabase()
    with db.lock():
        path = db.root / 'msf.secret'
        if path.exists() and path.read_text().strip() != request['password']:
            raise DatabaseError('DATABASE_CREDENTIALS_INVALID', 'Existing credential differs; restore the original credential.')
        if not path.exists():
            atomic_write(path, request['password'].encode())
    result = dict(ok=True)
except DatabaseError as error:
    result = dict(ok=False, errorKey=error.key, detail=error.detail)
print(json.dumps(result))
