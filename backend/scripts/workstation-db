#!/usr/bin/env python3
"""Protected-stdin entrypoint for fixed device PostgreSQL operations."""
import argparse
import json
import sys
from workstation_database import DatabaseError, ManagedDatabase, parse_request

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--request-stdin', action='store_true')
    group.add_argument('--job-request-json')
    args = parser.parse_args()
    try:
        raw = args.job_request_json or sys.stdin.read(8193)
        if args.job_request_json:
            request = json.loads(raw)
            if request.get('operation') == 'initialize':
                request['password'] = (ManagedDatabase().root / 'msf.secret').read_text().strip()
            raw = json.dumps(request)
        result = ManagedDatabase().invoke(parse_request(raw))
    except DatabaseError as error:
        result = dict(ok=False, errorKey=error.key, detail=error.detail)
    print(json.dumps(result))
    raise SystemExit(0 if result['ok'] else 1)
