{
  "name": "skid",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "preandroid": "npm run bundle:helper",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "export:android": "expo export --platform android --max-workers 2",
    "test:backend": "python3 -m unittest discover -s backend/tests -v",
    "test:dependencies": "node --test packages/decode-uri-component/compatibility.test.cjs",
    "build:standalone": "bash scripts/build-standalone.sh",
    "bundle:helper": "python3 scripts/build-helper-bundle.py"
  },
  "dependencies": {
    "decode-uri-component": "file:./packages/decode-uri-component",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-modules-core": "~57.0.18",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fast-xml-parser": "^5.11.1",
    "oni-terminal": "file:modules/terminal",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.10.1",
    "skid-jobs": "file:./modules/jobs",
    "skid-termux": "file:./modules/termux"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
